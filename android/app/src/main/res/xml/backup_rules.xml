<?xml version="1.0" encoding="utf-8"?>
<!-- COMMAND keeps all data on the device: nothing is included in Auto Backup (API 30 and below). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
