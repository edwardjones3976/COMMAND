<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: starts a ring from a shell. See DebugRingReceiver. Only the shell (adb) holds DUMP, so no other app can call it. -->
        <receiver android:name="com.command.debug.DebugRingReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.command.debug.RING" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: moves an occurrence's follow-up questions along from a shell. See DebugCheckInReceiver. -->
        <receiver android:name="com.command.debug.DebugCheckInReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.command.debug.CHECKIN_DUE" />
                <action android:name="com.command.debug.CHECKIN_ARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
